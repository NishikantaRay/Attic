{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"./hooks/attic-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading attic..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"./hooks/attic-mode.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"./hooks/attic-subagent.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
